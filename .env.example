# Copy to .env.local (not .env, see mise.toml).
# `mise run dev` and `mise run migrate` use the local dev PostgreSQL of the
# worktree (a container) and ignore DATABASE_URL. To use another database,
# set MASTOFEED_DATABASE_URL. Never set it to the production database.
# MASTOFEED_DATABASE_URL=postgresql://user:password@localhost:5432/mastofeed
MASTODON_BASE_URL=https://mastodon.example
MASTODON_ACCESS_TOKEN=replace_me
HOME_PAGE_URL=https://mastodon.example
CRON_SCHEDULE=*/5 * * * *
PORT=3000
FEED_LIMIT=200
FEED_TITLE=Mastodon timeline
FEED_DESCRIPTION=My personal Mastodon timeline feed
# Optional: json (default) or text
LOG_FORMAT=text
